{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "jsx": "react-jsx"
  },
  "include": ["src", "spikes", "dev"],
  "exclude": [
    "src/**/*.worker.ts",
    "spikes/**/*.worker.ts",
    "dev/**/*.worker.ts",
    "src/**/*.worklet.ts",
    "**/*.test.ts"
  ]
}
